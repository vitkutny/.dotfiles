function tmux-execution-reset () {
	if ! [ -n "$TMUX" ]; then
		return 1
	fi

	tmux set-option -p -u @last_status
	tmux set-option -p -u @last_pipestatus
	tmux set-option -p -u @last_execution_time
	if [ -n "$1" ]; then
		tmux set-option -p @last_execution_timestamp "$1"
	else
		tmux set-option -p -u @last_execution_timestamp
	fi
	tmux refresh-client -S
}
